# Supabase Configuration for Sentinel MPLADS Monitoring
# Replace with your actual project URL and service-role key from:
# Supabase Dashboard -> Project Settings -> API

# Project REST Endpoint (URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Secret Key (Required for ingestion script - bypasses RLS)
# DO NOT expose this key in client-side code or public repositories!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Anonymous Public Key (Optional for ingestion, used by future frontend)
SUPABASE_ANON_KEY=eyJhbGciOi...
